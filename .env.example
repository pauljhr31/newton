# Copy to .env (never commit .env). Easiest: python infra/scripts/make_env.py
# Use only letters and digits in passwords (they are embedded in connection URLs).

NEWTON_ENV=development

# PostgreSQL administrator (owner of the schema, used only for migrations and admin commands)
POSTGRES_USER=newton_admin
POSTGRES_PASSWORD=change-me

# Restricted role used by the running API (subject to Row-Level Security)
NEWTON_APP_DB_PASSWORD=change-me

# Signing key for session tokens (64+ random characters)
JWT_SECRET=change-me

# Must be true in production (HTTPS)
COOKIE_SECURE=false
